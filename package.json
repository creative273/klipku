{
  "name": "klipku",
  "productName": "Klipku",
  "version": "0.4.0",
  "description": "Klipku - video panjang jadi klip pendek (pemakaian pribadi)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "id.klipku.app",
    "productName": "Klipku",
    "directories": { "output": "dist" },
    "files": ["electron/**", "ui/**", "package.json"],
    "extraResources": [
      { "from": "engine", "to": "engine", "filter": ["**/*", "!**/__pycache__/**"] }
    ],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Klipku-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
